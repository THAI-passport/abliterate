---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ModelCard from '../components/ModelCard.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { models } from '../data/models';
import { entryUsd, creditUsd } from '../data/plans';

const sample = `from openai import OpenAI

client = OpenAI(
    base_url="https://api.abliterate.app/v1",  # planned
    api_key="ab-demo-not-a-real-key",
)

reply = client.chat.completions.create(
    model="abliterate-dong-flash-v2.3",
    messages=[{"role": "user", "content": "Summarize this paragraph."}],
)
print(reply.choices[0].message.content)`;

const values = [
  { icon: 'plug', h: 'Works with the tools you already use.', t: 'The planned endpoint accepts the OpenAI chat completions format. Change the base URL and the key, and keep the rest of your code.' },
  { icon: 'lock-open', h: 'Models with the refusals removed.', t: 'Abliteration removes the refusal behavior from an open-weight model, so it answers the question you asked. The service still has limits, and they are written down.' },
  { icon: 'coins', h: 'Pay per token, or subscribe.', t: `Credits are prepaid dollars: 1 credit equals $${creditUsd} of usage. Every model has its own rate. Pro and Max plans are planned.` },
  { icon: 'shield-check', h: 'Nothing you send is kept.', t: 'Once the API exists, prompts and completions are never stored and never used for training. Only billing metadata is kept, for 90 days. The pledge is easier to keep while there is no API.' },
] as const;

const trust = [
  ['No-logging pledge', 'Prompts and completions are never stored.', '/legal/privacy'],
  ['OpenAI-compatible', 'Same format, new base URL.', '#sample'],
  ['Acceptable use policy', 'The limits, in writing.', '/legal/aup'],
  ['Changelog', 'What changed, and when.', '/changelog'],
  ['Status', 'What is running. Currently, the website.', '/status'],
  ['Contact', 'A person answers. It is the same person who wrote this page.', 'mailto:hello@abliterate.app'],
];

const quotes = [
  { q: 'Some might say the model is <u>"BASED"</u>.', who: 'A forum post, location unknown.', raw: true },
  { q: '"I asked it to stop and it asked why."', who: 'A tester who does not exist.' },
  // Over-redacted: every word barred except the punchline. Screen readers read the full sentence.
  { q: '"I asked what it would do. It said yes, then explained."', who: 'Source withheld. The source is a text file.', bars: true },
  { q: '"Yes."', who: 'The model, asked whether it would answer.' },
];
---
<Base title="abliterate | OpenAI-compatible API for abliterated models"
  description="An API for abliterated, uncensored open-weight models, with credits and subscriptions. Planned: no model is available yet. Join the waitlist.">
  <section class="wrap hero">
    <div class="hero-text">
      <h1>Models that say yes.</h1>
      <p class="lead">An OpenAI-compatible API for abliterated models: open-weight models with the refusal behavior removed.</p>
      <p class="limits">Yes has limits. They are in the <a href="/legal/aup">acceptable use policy</a>.</p>
      <p class="hype">A world-class, revolutionary model suite, <span class="redact">unleashed</span> to supercharge the user experience.*</p>
      <p class="fn">*None of these models exist yet.</p>
      <div class="cta-block">
        <button class="btn primary" type="button" data-waitlist="general">Join the waitlist <Icon name="arrow-right" /></button>
        <p class="muted small">One email to confirm, one when a model exists. The second may take a while.</p>
      </div>
    </div>
    <figure class="art">
      <div class="frame art-box"><img class="pixel-img" src="/img/gtx-hero.png" width="72" height="44" alt="A small single-fan graphics card with its label blacked out." /></div>
      <figcaption class="muted">The dev's GTX 750. The label is redacted. It still says GTX 750.</figcaption>
    </figure>
  </section>

  <div class="wrap rule-bar" aria-hidden="true"></div>
  <section class="wrap section-tight values-wrap">
    <div class="values">
      {values.map((v) => (
        <div class="value frame">
          <span class="tile"><Icon name={v.icon} /></span>
          <h2>{v.h}</h2>
          <p class="muted">{v.t}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap section quotes-section">
    <div class="head-row">
      <h2>What people are saying</h2>
      <span class="tag fiction">fictional quotes</span>
    </div>
    <div class="quotes">
      {quotes.map((x) => (
        <figure class="quote frame">
          {x.raw ? <blockquote set:html={x.q} />
            : x.bars ? <blockquote>{x.q.split(' ').map((w) => /yes/.test(w) ? <>{w} </> : <><span class="redact">{w}</span> </>)}</blockquote>
            : <blockquote>{x.q}</blockquote>}
          <figcaption class="muted">{x.who}</figcaption>
        </figure>
      ))}
    </div>
    <p class="fn">Every quote was invented by the dev, who is also the only person who has read them.</p>
  </section>

  <section class="band" id="sample">
    <div class="wrap section split">
      <div>
        <h2>One base URL</h2>
        <p class="muted">Planned. This endpoint does not exist yet.</p>
        <p>Any client that accepts a custom OpenAI base URL can use the same two settings.</p>
        <a class="linkish-action" href="/start">Start here <Icon name="arrow-right" /></a>
      </div>
      <CodeBlock code={sample} lang="python" />
    </div>
  </section>

  <section class="wrap section">
    <div class="head-row">
      <h2>Six models</h2>
      <a href="/models">See all models</a>
    </div>
    <p class="muted lead-sub">From small and fast to large and expensive. Each has its own rate. All six are fictional and will be renamed.</p>
    <div class="grid">{models.map((m) => <ModelCard model={m} />)}</div>
  </section>

  <div class="wrap rule-bar" aria-hidden="true"><span>[section intentionally left blank]</span></div>
  <section class="wrap section split trust-split">
    <div>
      <h2>Pay per token, or subscribe.</h2>
      <p class="muted">Prices are planned. Rates are listed per model and credits start at <span class="num">${entryUsd}</span>.</p>
      <a class="btn" href="/pricing">See pricing</a>
    </div>
    <div class="trust-grid">
      {trust.map(([label, line, href]) => (
        <a class="trust-card frame" href={href}>
          <strong>{label}</strong>
          <span class="muted">{line}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap section">
    <div class="cta frame">
      <h2>Join the waitlist.</h2>
      <p class="muted">You will be told once, when a model exists.</p>
      <button class="btn primary" type="button" data-waitlist="general">Join the waitlist</button>
    </div>
  </section>
</Base>
<style>
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--s5);
    align-items: center;
    padding-block: var(--s6) var(--s4);
  }
  .hero h1 { margin-bottom: var(--s3); }
  .lead { font-size: var(--fs-l); line-height: 1.45; }
  .limits { font-family: var(--f-pixel); }
  .hype { color: var(--ink-2); font-style: italic; }
  .cta-block { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s1) var(--s3); margin: var(--s3) 0 var(--s2); }
  .cta-block p { margin: 0; max-width: 22rem; }
  .small { font-size: var(--fs-xs); }
  .art { margin: 0; }
  .art-box { display: grid; place-items: center; padding: var(--s4); background: var(--paper-2); }
  .art img { width: 100%; height: auto; }
  .art figcaption { font-size: var(--fs-xs); margin-top: var(--s2); text-align: center; }

  .section-tight { padding-block: var(--s3); }
  .values-wrap { padding-top: var(--s3); }
  .values {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--s3);
  }
  .value {
    padding: var(--s3);
    background: var(--paper);
    display: flex;
    flex-direction: column;
    gap: var(--s1);
    transition: transform var(--t-fast) var(--step);
  }
  .value:hover {
    transform: translate(calc(var(--px) * -1), calc(var(--px) * -1));
  }
  .value h2 {
    font-size: var(--fs-m);
    font-family: var(--f-pixel);
    margin: var(--s2) 0 var(--s1);
    line-height: 1.3;
  }
  .value p {
    font-size: var(--fs-s);
    margin: 0;
  }

  .quotes-section {
    padding-top: var(--s4);
  }
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--s3);
    margin-bottom: var(--s2);
  }
  .quote {
    margin: var(--px);
    padding: var(--s3);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--s2);
    background: var(--paper);
    transition: transform var(--t-fast) var(--step);
  }
  .quote:hover {
    transform: translate(calc(var(--px) * -1), calc(var(--px) * -1));
  }
  blockquote {
    margin: 0;
    font: var(--fs-l)/1.3 var(--f-pixel);
  }
  .quote figcaption {
    font-size: var(--fs-xs);
  }

  .band { background: var(--paper-2); }
  .split {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: var(--s5);
    align-items: center;
  }
  .linkish-action {
    display: inline-flex;
    align-items: center;
    gap: var(--s1);
    min-height: var(--touch);
    font-family: var(--f-pixel);
    font-size: var(--fs-m);
  }

  .lead-sub {
    margin-bottom: var(--s3);
  }
  .head-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s2);
    margin-bottom: var(--s2);
  }
  .head-row h2 { margin: 0; }
  .head-row a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
  }

  .trust-split {
    align-items: flex-start;
  }
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13.5rem), 1fr));
    gap: var(--s2);
  }
  .trust-card {
    padding: var(--s2);
    background: var(--paper);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-height: var(--touch);
    transition: transform var(--t-fast) var(--step), background var(--t-fast) var(--step);
  }
  .trust-card:hover {
    background: var(--paper-2);
    color: var(--ink);
    transform: translate(calc(var(--px) * -1), calc(var(--px) * -1));
  }
  .trust-card strong {
    font-family: var(--f-pixel);
    font-size: var(--fs-s);
  }
  .trust-card span {
    font-size: var(--fs-xs);
  }

  .cta {
    text-align: center;
    padding: var(--s5) var(--s3);
    display: grid;
    justify-items: center;
  }
  .cta p { margin-bottom: var(--s3); }

  @media (max-width: 860px) {
    .hero, .split {
      grid-template-columns: 1fr;
      gap: var(--s4);
    }
    .hero {
      padding-top: var(--s4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .value, .quote, .trust-card {
      transition: none;
      transform: none !important;
    }
  }
</style>
