---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ModelCard from '../../components/ModelCard.astro';
import { models } from '../../data/models';
---
<Base title="Models" description="Six planned abliterated models from small and fast to large and expensive. All fictional, none available yet.">
  <PageHead title="Models">Six models, from small and fast to large and expensive. All six are fictional and will be renamed. Rates are per 1M tokens and are on the <a href="/pricing">pricing page</a>.</PageHead>
  <div class="wrap section first">
    <div class="grid">{models.map((m) => <ModelCard model={m} />)}</div>
  </div>
</Base>
<style>
  .first { padding-top: var(--s2); }
</style>
