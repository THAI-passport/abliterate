---
import { footer } from '../data/site';
import Logo from './Logo.astro';
---
<footer class="foot">
  <div class="wrap cols">
    <div><Logo /><p class="muted">abliterate is a storefront for models that do not exist yet.</p><p class="muted"><a href="mailto:hello@abliterate.app">hello@abliterate.app</a></p></div>
    {footer.map((c) => (
      <div><p class="eyebrow">{c.title}</p><ul>{c.links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul></div>
    ))}
  </div>
  <div class="wrap muted small bottom">
    <span>abliterate &middot; {new Date().getFullYear()}</span>
    <span class="ledger">Words redacted on this site: <span class="num">__REDACT_COUNT__</span>. Words that needed it: <span class="num">0</span>.</span>
  </div>
</footer>
<style>
  .foot { border-top: 2px solid var(--line); padding: var(--s4) 0 var(--s3); margin-top: var(--s5); }
  .cols { display: grid; gap: var(--s3); grid-template-columns: 2fr repeat(3, 1fr); }
  @media (max-width: 720px) { .cols { grid-template-columns: 1fr 1fr; } .cols > :first-child { grid-column: 1 / -1; } }
  ul { list-style: none; margin: 0; padding: 0; }
  li a { display: inline-flex; align-items: center; min-height: var(--touch); min-width: var(--touch); }
  .small { font-size: var(--fs-xs); margin-top: var(--s3); }
  .bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s1) var(--s3); }
</style>
