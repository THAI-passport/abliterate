---
import { nav } from '../data/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
---
<header class="nav">
  <div class="wrap row">
    <Logo />
    <button class="btn menu" type="button" aria-expanded="false" aria-controls="nav-links"><Icon name="menu" label="Menu" /></button>
    <nav id="nav-links" aria-label="Main">
      <ul>
        {nav.map((n) => n.href
          ? <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
          : <li><span class="soon">{n.label} <span class="tag">Soon</span></span></li>)}
      </ul>
      <div class="actions">
        <button class="btn theme" type="button" aria-label="Switch colour theme"><Icon name="sun" /><Icon name="moon" /></button>
        <button class="btn primary" type="button" data-waitlist="general">Join waitlist</button>
      </div>
    </nav>
  </div>
</header>
<style>
  .nav { border-bottom: 2px solid var(--line); }
  .row { display: flex; align-items: center; justify-content: space-between; gap: var(--s2); padding-block: var(--s1); }
  nav { display: flex; align-items: center; gap: var(--s3); }
  ul { display: flex; gap: var(--s2); list-style: none; margin: 0; padding: 0; font-family: var(--f-pixel); }
  ul a, .soon { display: inline-flex; align-items: center; gap: var(--s1); min-height: var(--touch); padding: 0 var(--s1); text-decoration: none; }
  ul a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--action); text-decoration-thickness: 3px; }
  .soon { color: var(--ink-2); }
  .actions { display: flex; align-items: center; gap: var(--s1); }
  .theme { padding: 0 var(--s1); }
  :root:not([data-theme='dark']) .theme .icon:last-child, :root[data-theme='dark'] .theme .icon:first-child { display: none; }
  .menu { display: none; padding: 0 var(--s1); }
  @media (max-width: 860px) {
    .menu { display: inline-flex; }
    nav { display: none; position: absolute; left: 0; right: 0; top: 4.25rem; z-index: 10; flex-direction: column; align-items: stretch; padding: var(--s2); background: var(--paper); border-bottom: 2px solid var(--line); }
    nav.open { display: flex; }
    ul { flex-direction: column; gap: 0; }
  }
</style>
<script>
  const menu = document.querySelector<HTMLButtonElement>('.menu')!;
  const links = document.getElementById('nav-links')!;
  menu.addEventListener('click', () => {
    const open = links.classList.toggle('open');
    menu.setAttribute('aria-expanded', String(open));
  });
  document.querySelector('.theme')!.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    root.dataset.theme = dark ? 'light' : 'dark';
    try { localStorage.setItem('theme', root.dataset.theme); } catch {}
  });
</script>
