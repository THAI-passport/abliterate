---
// <details> is in-page and keyboard friendly; no native pop-up involved.
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
import Icon from './Icon.astro';
---
<div class="acc">
  {items.map((i) => (
    <details class="frame">
      <summary><span>{i.q}</span><Icon name="chevron-down" /></summary>
      <p>{i.a}</p>
    </details>
  ))}
</div>
<style>
  .acc { display: grid; gap: var(--s2); }
  summary { min-height: var(--touch); display: flex; justify-content: space-between; align-items: center; gap: var(--s2); padding: var(--s1) var(--s2); cursor: pointer; font-family: var(--f-pixel); list-style: none; }
  summary::-webkit-details-marker { display: none; }
  details[open] summary .icon { transform: rotate(180deg); }
  details p { padding: 0 var(--s2) var(--s2); margin: 0; }
</style>
