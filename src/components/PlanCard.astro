---
import type { Plan } from '../data/plans';
interface Props { plan: Plan }
const { plan: p } = Astro.props;
---
<article class={`plan frame ${p.featured ? 'featured' : ''}`}>
  <div class="head"><h3>{p.name}</h3><span class="tag">Planned</span></div>
  <p class="price"><span class="num">${p.price}</span><span class="muted">/month</span></p>
  <p class="muted">{p.credits}</p>
  <ul>{p.features.map((f) => <li>{f}</li>)}</ul>
  <button class={`btn ${p.featured ? 'primary' : ''}`} type="button" data-waitlist={p.id}>Join the {p.name} waitlist</button>
</article>
<style>
  .plan { padding: var(--s3); display: flex; flex-direction: column; }
  .featured { --shadow: var(--action); }
  .head { display: flex; justify-content: space-between; align-items: start; gap: var(--s1); }
  .price .num { font-size: 3rem; }
  ul { padding-left: 1.2em; margin: 0 0 var(--s3); flex: 1; }
</style>
